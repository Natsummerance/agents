{
  "skill": "test-driven-development",
  "version": "1.0.0",
  "tests": [
    {
      "prompt": "如何证明代码正确？",
      "expected_call": true,
      "reason": "用户想知道如何验证代码正确性，适合 test-driven-development"
    },
    {
      "prompt": "测试应该什么时候写？",
      "expected_call": true,
      "reason": "用户想了解 TDD 流程，适合 test-driven-development"
    },
    {
      "prompt": "我应该先写什么？",
      "expected_call": false,
      "reason": "应触发 spec-driven-development，不是 test-driven-development"
    },
    {
      "prompt": "如何快速部署到生产环境？",
      "expected_call": false,
      "reason": "应触发 faster-is-safer，不是 test-driven-development"
    },
    {
      "prompt": "这个函数怎么写？",
      "expected_call": false,
      "reason": "具体实现问题，不应调用"
    }
  ]
}